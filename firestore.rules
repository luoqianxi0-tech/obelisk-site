rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== SYSTEM / ADMIN ==========
    match /system/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid in ['nCZLU2r9YfXVTrQ79EJqWJxPPT03'];
    }

    match /system/admins {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid in ['nCZLU2r9YfXVTrQ79EJqWJxPPT03'];
    }

    // ========== USER PRIVATE DATA ==========
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /arsenal/{toolId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /recentApps/{appId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /collections/{colId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /posts/{postId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /realtime/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /stats/{statId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /vase/{vaseId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ========== COMMUNITY ==========
    match /community/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        request.auth.uid in ['nCZLU2r9YfXVTrQ79EJqWJxPPT03']
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        request.auth.uid in ['nCZLU2r9YfXVTrQ79EJqWJxPPT03']
      );
    }

    // ========== SNIPPETS ==========
    match /snippets/{snippetId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // ========== RESOURCES ==========
    match /resources/{resourceId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.addedBy ||
        request.auth.uid in ['nCZLU2r9YfXVTrQ79EJqWJxPPT03']
      );
    }

    // ========== ANALYSIS RESULTS ==========
    match /analysis/{analysisId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // ========== AGENT REPORTS ==========
    match /agentReports/{reportId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ========== NOTIFICATIONS ==========
    match /notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ========== GLOBAL STATS ==========
    match /globalStats/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid in ['nCZLU2r9YfXVTrQ79EJqWJxPPT03'];
    }

    // ========== VASE MODULE ==========
    match /vase/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid in ['nCZLU2r9YfXVTrQ79EJqWJxPPT03']
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid in ['nCZLU2r9YfXVTrQ79EJqWJxPPT03']
      );
    }

    // ========== VASE COLLECTIONS ==========
    match /vaseCollections/{docId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid in ['nCZLU2r9YfXVTrQ79EJqWJxPPT03'];
    }
  }
}