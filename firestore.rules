rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ========== SYSTEM CONFIG (ADMIN ONLY) ==========
    match /system/{docId} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/system/admins) &&
        get(/databases/$(database)/documents/system/admins).data.uids.hasAny([request.auth.uid]);
      allow write: if false; // 仅手动通过控制台修改
    }

    // ========== USER PRIVATE DATA ==========
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // 军火库子集合
      match /arsenal/{toolId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // 最近分析子集合
      match /recentApps/{appId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // 活动日志子集合
      match /logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // 收藏子集合
      match /collections/{colId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // 帖子子集合 (My Posts)
      match /posts/{postId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Agent 实时数据通道
      match /realtime/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // 历史会话
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // 统计
      match /stats/{statId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ========== COMMUNITY (PUBLIC READ, AUTH WRITE) ==========
    match /community/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        (exists(/databases/$(database)/documents/system/admins) &&
         get(/databases/$(database)/documents/system/admins).data.uids.hasAny([request.auth.uid]))
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        (exists(/databases/$(database)/documents/system/admins) &&
         get(/databases/$(database)/documents/system/admins).data.uids.hasAny([request.auth.uid]))
      );
    }

    // ========== SNIPPETS ==========
    match /snippets/{snippetId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // ========== RESOURCES ==========
    match /resources/{resourceId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.addedBy ||
        (exists(/databases/$(database)/documents/system/admins) &&
         get(/databases/$(database)/documents/system/admins).data.uids.hasAny([request.auth.uid]))
      );
    }
  }
}