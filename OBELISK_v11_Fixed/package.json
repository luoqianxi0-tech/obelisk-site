{
  "name": "obelisk",
  "private": true,
  "version": "11.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:github": "npm run build && node -e \"require('fs').cpSync('dist','build',{recursive:true,force:true}); console.log('Copied dist -> build for Pages')\"",
    "deploy:firebase": "npm run build && firebase deploy --only hosting",
    "deploy:vercel": "npm run build && vercel --prod",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "firebase": "^10.12.2",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.395.0",
    "recharts": "^2.12.7",
    "i18next": "^23.11.5",
    "react-i18next": "^14.1.2",
    "i18next-browser-languagedetector": "^8.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.13",
    "vite-plugin-pwa": "^0.20.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.obelisk.app",
    "productName": "OBELISK",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*"],
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}